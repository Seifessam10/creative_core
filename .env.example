# Start a Project inquiry delivery (PRD §6, §11 — decisions required before production).
# Without these two set, inquiries are logged to the server console instead of emailed,
# so the flow is still fully testable in development.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL="Creative Core <onboarding@resend.dev>"

# Optional: internal WhatsApp notification via an approved WhatsApp Business
# API/provider (PRD §5 step 5, §11). Leave both unset to skip WhatsApp entirely.
WHATSAPP_API_TOKEN=
WHATSAPP_NOTIFY_NUMBER=
